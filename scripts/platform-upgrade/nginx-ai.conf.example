# Review paths/upstream and merge into the site's existing server block before deployment.
# The prepared frontend release uses VITE_API_BASE_URL=/api.
location = /api/ais/chat {
    proxy_pass http://127.0.0.1:10010/ais/chat;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 200s;
}
location /api/ {
    proxy_pass http://127.0.0.1:10010/;
    proxy_set_header Host $host;
}
