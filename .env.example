# Variable names and non-secret examples only.
# Spring Boot does not load this file automatically. Export variables in your
# shell, IDE, container, or deployment platform. Never commit real values.
SPRING_PROFILES_ACTIVE=local
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=tianji-local-boot3
SERVICE_IP=127.0.0.1

TJ_AUTH_KEY_STORE=file:./secrets/tianji.jks
TJ_AUTH_KEY_ALIAS=tianji
TJ_AUTH_KEY_STORE_PASSWORD=
# Optional: defaults to the keystore password.
# TJ_AUTH_KEY_PASSWORD=

DEEPSEEK_API_KEY=
TJ_AIGC_ES_PASSWORD=
TJ_AIGC_MONGODB_URI=
TJ_AIGC_VECTOR_REDIS_PASSWORD=

TJ_TENCENT_APP_ID=0
TJ_TENCENT_SECRET_ID=
TJ_TENCENT_SECRET_KEY=
TJ_TENCENT_VOD_URL_KEY=
TJ_TENCENT_COS_BUCKET=
TJ_SMS_ALI_ACCESS_ID=
TJ_SMS_ALI_ACCESS_SECRET=

# Opt-in external payment SDK tests; keep disabled for ordinary builds.
TJ_ALIPAY_LIVE_TEST=false
TJ_ALIPAY_APP_ID=
TJ_ALIPAY_MERCHANT_PRIVATE_KEY=
TJ_ALIPAY_PUBLIC_KEY=
TJ_ALIPAY_NOTIFY_URL=
TJ_ALIPAY_TEST_ORDER_NO=
TJ_ALIPAY_TEST_REFUND_NO_1=
TJ_ALIPAY_TEST_REFUND_NO_2=
