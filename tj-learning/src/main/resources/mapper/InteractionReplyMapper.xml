<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianji.learning.mapper.interaction.InteractionReplyMapper">

    <!--
        互动问答（回答／评论表）的自定义 SQL 预留位。

        基础 CRUD 由 MyBatis-Plus 的 BaseMapper 提供，这里只放需要手写 SQL 的部分，比如：
          · 用户端／管理端分页查询回答列表（要关联出回答人信息、被回复人信息）
          · 回答下的评论计数、点赞计数

        写法对齐两步走，缺一不可：
          1) 在 InteractionReplyMapper 接口里加方法签名（多参数用 @Param("name") 命名）
          2) 在本文件里加 <select id="方法名" ...>，id 必须与方法名逐字一致
        漏掉任意一步，运行时报 "Invalid bound statement (not found)"。
    -->
</mapper>
